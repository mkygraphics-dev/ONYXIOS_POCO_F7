diff --git a/common/devices/onyx.conf b/common/devices/onyx.conf
new file mode 100644
index 0000000..dd52ef3
--- /dev/null
+++ b/common/devices/onyx.conf
@@ -0,0 +1,38 @@
+# POCO F7 (onyx) -- the Snapdragon 8 Elite (SM8735, "tuna").
+#
+# Everything the loader and the build need to know about this phone. The addresses
+# the kernel uses are not here: they are in the kernel's own SoC profile
+# (xnu/files/bsd/dev/redwood_soc.c), which the loader names on the kernel's
+# command line ("soc=onyx").
+NAME="POCO F7 (onyx)"
+KIND=phone
+SOC="Qualcomm Snapdragon 8 Elite (SM8735, tuna)"
+
+UEFI_TARGET=onyx
+UEFI_FD=
+DTB=
+# TODO: the UEFI port's memory map (see docs/PORTING-onyx.md, "The UEFI").
+# The numbers below are redwood's, as a starting point: the FD has to be where the
+# phone's own bootloader puts it, and the payload has to be below PAYLOAD_BASE
+# with room for the images (about 2.5 GB).
+FD_BASE=0x9FD00000
+FD_SIZE=0x200000
+PAYLOAD_BASE=0xF0000000
+
+# TODO: the framebuffer the phone's UEFI reports ("display 1220 x 2712 at ..." in
+# the loader's log). The loader tells the phones apart by it, so it has to be
+# right: a wrong one makes the loader pick another phone's description.
+FB_BASE=0x0
+WIFI_ATH11K=1                   # WCN786x (Wi-Fi 7): the same driver, other firmware
+
+# bootcpu=7: run on the prime core; cpufreq=1: top speed; add gpu=1 (with GL=1
+# images), wifi=1, adsp=1
+# touchscreen=1 is redwood's: this phone's panel is a FocalTech behind Trusted
+# Touch, and there is no driver for it yet (docs/PORTING-onyx.md).
+BOOTARGS="cpufreq=1 bootcpu=7 cpus=8"
+DEFAULT_SECS=900
+USERLAND_VARS=""
+# TODO: taken from the phone's Android with adb (see README.md, "On the phone").
+# They are not redwood's: the GPU is an Adreno 7xx, the radio a WCN786x and the
+# audio a PM7550BA.
+FIRMWARE="fw-gpu fw-wifi fw-audio fw-haptic"
diff --git a/common/devices/onyx.platform.c b/common/devices/onyx.platform.c
new file mode 100644
